# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs (any location)
logs/
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS-specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# editors & IDEs
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# testing / tooling cache
.vitest-cache/
.eslintcache
.turbo/

# local databases / dumps
*.sqlite
*.sqlite3
*.db

# uploaded files (local storage driver)
/.storage/

# stray screenshot dumps
/Claude outputs/

# local testing harness (Playwright probes, scratch-DB fixtures, reports)
/probe/
/.scratch/
/scratch/
/tmp/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
scripts/_tmp-*

# dev logs & working notes (the journal lives in docs/WORKLOG.md)
/.dev/
/PLAN.md
/*_PLAN.md
/*_AUDIT.md
/*_BUG.md
/*.png
