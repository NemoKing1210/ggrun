{
  "name": "ggrun",
  "version": "0.5.0",
  "description": "GGRun — seasonal gaming event platform: HPG runs, board with cell effects, dice movement, leaderboard and admin console",
  "author": "NemoKing1210 <https://github.com/NemoKing1210>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NemoKing1210/ggrun.git"
  },
  "homepage": "https://github.com/NemoKing1210/ggrun#readme",
  "bugs": {
    "url": "https://github.com/NemoKing1210/ggrun/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/NemoKing1210"
    },
    {
      "type": "individual",
      "url": "https://github.com/NemoKing1210/ggrun"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "keywords": [
    "gaming",
    "nextjs",
    "drizzle",
    "board-game",
    "hpg",
    "leaderboard",
    "seasonal-event"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:next": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --turbopack",
    "server": "tsx server.ts",
    "start": "tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "prepare": "husky",
    "db:status": "tsx scripts/db-status.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:setup": "pnpm db:push && pnpm db:seed && pnpm db:admin",
    "bots:tick": "tsx scripts/bots-tick.ts",
    "db:admin": "tsx scripts/bootstrap-admin.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "scenarios:doc": "tsx scripts/scenarios-doc.ts",
    "iee:art": "tsx scripts/iee-art.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.102.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "next": "15.5.24",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^6.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
