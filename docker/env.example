# =============================================================================
# GGRun — docker deployment environment template
#
#   cp docker/env.example .env        (merge with your existing .env values)
#   docker compose up --build
#
# All variables except POSTGRES_* already exist in the dev `.env`;
# compose falls back to sensible defaults when a variable is missing.
# =============================================================================

# --- Postgres (used by the "db" service and to build DATABASE_URL) ------------
POSTGRES_USER=ggrun
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ggrun
# Host port for Postgres — 5433 avoids clashing with a local OSPanel instance.
POSTGRES_PORT=5433

# --- App -----------------------------------------------------------------------
# Host port for the web app.
APP_PORT=3000

# Session signing secret — generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Secret for POST /api/bots/tick (autonomous ticker). Empty disables it (503).
CRON_SECRET=

# Public base URL (inlined into the client bundle at build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed a demo season (run-1) on first boot — idempotent.
SEED_DEMO=true

# Optional: create/promote the first admin account on boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional external game catalog APIs ---------------------------------------
RAWG_API_KEY=
STEAM_WEB_API_KEY=
GAMESPOT_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PROXY_URL=

# --- File storage ---------------------------------------------------------------
# Where uploaded avatars, banners, game covers and attachments are kept.
#   local → written into the `storage` volume mounted at /app/.storage
#   s3    → any S3-compatible object store (AWS S3, R2, MinIO, B2, …)
# With the s3 driver the volume is unused and objects live in the bucket.
STORAGE_DRIVER=local

# local driver: directory inside the container (the compose volume mounts here).
STORAGE_LOCAL_ROOT=/app/.storage

# Optional public base URL for direct delivery (public bucket or CDN). Empty →
# the app streams every object through /api/files.
STORAGE_PUBLIC_URL=

# Optional dedicated secret for signing private access links. Empty → AUTH_SECRET.
STORAGE_SIGNING_SECRET=

# Hard ceiling for a single upload, in bytes.
STORAGE_MAX_UPLOAD_BYTES=8388608

# s3 driver (only read when STORAGE_DRIVER=s3):
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Leave blank on AWS to use the instance role / task credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false