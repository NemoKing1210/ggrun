# =============================================================================
# GGRun — docker deployment environment template
#
#   cp docker/env.example .env        (merge with your existing .env values)
#   docker compose up --build
#
# All variables except POSTGRES_* already exist in the dev `.env`;
# compose falls back to sensible defaults when a variable is missing.
# =============================================================================

# --- Postgres (used by the "db" service and to build DATABASE_URL) ------------
POSTGRES_USER=ggrun
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ggrun
# Host port for Postgres — 5433 avoids clashing with a local OSPanel instance.
POSTGRES_PORT=5433

# --- App -----------------------------------------------------------------------
# Host port for the web app.
APP_PORT=3000

# Session signing secret — generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Public base URL (inlined into the client bundle at build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed a demo season (run-1) on first boot — idempotent.
SEED_DEMO=true

# Optional: create/promote the first admin account on boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional external game catalog APIs ---------------------------------------
RAWG_API_KEY=
STEAM_WEB_API_KEY=
GAMESPOT_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PROXY_URL=