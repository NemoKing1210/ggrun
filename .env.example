# =============================================================================
# GGRun — example environment file
#
# Usage: copy this file to `.env` and fill in the real values.
#   cp .env.example .env
# `.env*` files are git-ignored; never commit real secrets.
# =============================================================================

# --- Database ------------------------------------------------------------------
# PostgreSQL connection string.
# - Local dev: OSPanel PostgreSQL 16 module (host 127.127.126.55 is the
#   OSPanel-internal address, NOT a typo).
# - Cloud: use your managed Postgres (e.g. Supabase) connection string.
#
# Format: postgresql://<user>[:<password>]@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres@127.127.126.55:5432/ggrun

# --- Auth ----------------------------------------------------------------------
# Secret used to sign session cookies. Must be a long random string.
# Generate one:
#   openssl rand -base64 32        (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Rotate it to invalidate all existing sessions.
AUTH_SECRET=change-me-in-local-env

# --- Site URL --------------------------------------------------------------------
# Public base URL of the site; used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- External game catalog APIs -------------------------------------------------
# Optional. Used by seasons when source=api/hybrid and provider=rawg/igdb/steam/gamespot.
# All keys can be left empty if the project only uses local game records.

# FreeToGame — no key, no registration, always available. Works out of the box:
# https://www.freetogame.com/api-doc

# RAWG — free API key: https://rawg.io/apidocs
RAWG_API_KEY=

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# GameSpot — free API key: https://www.gamespot.com/api
GAMESPOT_API_KEY=

# Outbound proxy for external APIs — http://user:pass@host:port.
# Admin Settings → Integrations can override this at runtime.
PROXY_URL=

# IGDB (Twitch) credentials: https://api-docs.igdb.com — create a Twitch app,
# then copy its Client ID and generate a Client Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Bootstrap admin ------------------------------------------------------------
# Credentials for creating the first admin account. Used ONLY by:
#   pnpm exec tsx scripts/bootstrap-admin.ts
# Fill them in, run the script once, then remove from `.env`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

